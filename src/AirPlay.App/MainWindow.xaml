<Window x:Class="AirPlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowsAirplay"
        Icon="Assets/app.ico"
        Width="480" Height="860" MinWidth="240" MinHeight="240"
        Background="Black"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="Root" Background="Black" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid.ContextMenu>
            <ContextMenu Opened="Menu_Opened">
                <MenuItem Header="全螢幕" InputGestureText="F11" Click="FullScreen_Click" />
                <MenuItem x:Name="TopmostItem" Header="最上層顯示" IsCheckable="True" Click="Topmost_Click" />
                <Separator />
                <MenuItem x:Name="RenameItem" Header="重新命名…" Click="Rename_Click" />
                <MenuItem Header="畫面更新率">
                    <MenuItem x:Name="Fps30Item" Header="30 fps（較省電）" IsCheckable="True" Click="Fps_Click" Tag="30" />
                    <MenuItem x:Name="Fps60Item" Header="60 fps（較流暢）" IsCheckable="True" Click="Fps_Click" Tag="60" />
                </MenuItem>
                <MenuItem x:Name="AppVideoItem" Header="App 影片直接播放（YouTube、Twitch、Safari）" IsCheckable="True" Click="AppVideo_Click"
                          ToolTip="開啟：App 的 AirPlay 按鈕由電腦直接播放影片；鏡像中開這些影片時，iPhone 會自動切成影片模式。&#x0a;關閉：永遠鏡像整個手機畫面；App 的 AirPlay 按鈕只有聲音。" />
                <MenuItem x:Name="AutoStartItem" Header="開機時自動啟動" IsCheckable="True" Click="AutoStart_Click" />
                <MenuItem x:Name="CloseToTrayItem" Header="關閉視窗時縮到系統匣" IsCheckable="True" Click="CloseToTray_Click" />
                <MenuItem Header="設定防火牆…" Click="Firewall_Click" />
                <Separator />
                <MenuItem Header="開啟記錄資料夾" Click="OpenLogs_Click" />
                <Separator />
                <MenuItem Header="結束" Click="Exit_Click" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Image x:Name="Video" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- Audio-only AirPlay (music, or a video app sending sound only): what's playing -->
        <StackPanel x:Name="MusicPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="24" MaxWidth="420">
            <Border CornerRadius="10" ClipToBounds="True" Background="#222" Width="300" Height="300">
                <Grid>
                    <TextBlock Text="♪" FontSize="96" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image x:Name="Artwork" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>
            <TextBlock x:Name="TrackTitle" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,20,0,4"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TrackArtist" Foreground="#B0B0B0" FontSize="15" TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="TrackProgress" Height="4" Margin="0,20,0,6" Maximum="1" Background="#333"
                         Foreground="#2C8CFF" BorderThickness="0" />
            <Grid>
                <TextBlock x:Name="TrackPosition" Foreground="#909090" FontSize="12" HorizontalAlignment="Left" />
                <TextBlock x:Name="TrackDuration" Foreground="#909090" FontSize="12" HorizontalAlignment="Right" />
            </Grid>
            <TextBlock x:Name="MusicHint" Foreground="#606060" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,18,0,0" Text="只有聲音？這個 App 可能只送聲音，或影片有版權保護（DRM）。可以改用「螢幕鏡像輸出」。" />
        </StackPanel>

        <StackPanel x:Name="Waiting" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <TextBlock x:Name="WaitingTitle" Text="等待 iPhone 連線" Foreground="White" FontSize="22"
                       HorizontalAlignment="Center" Margin="0,0,0,16" />
            <TextBlock x:Name="WaitingHint" Foreground="#B0B0B0" FontSize="14" TextAlignment="Center"
                       TextWrapping="Wrap" LineHeight="22" />

            <Border x:Name="FirewallBanner" Visibility="Collapsed" Margin="0,24,0,0" Padding="14,10"
                    CornerRadius="6" Background="#33FFB020" BorderBrush="#FFB020" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="FirewallText" Foreground="#FFD27A" TextWrapping="Wrap" TextAlignment="Center"
                               Text="防火牆還沒設定，iPhone 可能連不進來。" />
                    <Button x:Name="FirewallButton" Content="設定防火牆（需要系統管理員確認）" Margin="0,8,0,0"
                            Padding="10,4" HorizontalAlignment="Center" Click="Firewall_Click" />
                </StackPanel>
            </Border>

            <TextBlock Foreground="#707070" FontSize="12" TextAlignment="Center" Margin="0,24,0,0"
                       Text="右鍵：選單　F11 / 雙擊：全螢幕" />
        </StackPanel>

        <TextBlock x:Name="Status" Foreground="#80FFFFFF" FontSize="11" Margin="8,0,0,6"
                   VerticalAlignment="Bottom" HorizontalAlignment="Left" IsHitTestVisible="False" />
    </Grid>
</Window>
