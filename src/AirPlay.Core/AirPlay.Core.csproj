<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="plist-cil" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- FairPlay (playfair) native library, built by native\playfair\build.cmd -->
    <None Include="..\..\native\playfair\bin\playfair.dll" Link="playfair.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
