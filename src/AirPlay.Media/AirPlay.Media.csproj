<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- C# bindings for FFmpeg 7.1 -->
    <PackageReference Include="FFmpeg.AutoGen" Version="7.1.1" />
    <!-- FFmpeg 7.1 DLLs (GPL build), copied to runtimes\win-x64\native -->
    <PackageReference Include="Sdcb.FFmpeg.runtime.windows-x64" Version="7.1.0" />
  </ItemGroup>

</Project>
